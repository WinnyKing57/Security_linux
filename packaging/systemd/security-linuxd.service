[Unit]
Description=Security-Linux daemon (verrouillage automatique)
Documentation=https://github.com/WinnyKing57/Security_linux
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/security-linuxd
Restart=on-failure
RestartSec=3

# ---- Durcissement : limites les dégâts si le démon est exploité ----
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK AF_BLUETOOTH
SystemCallArchitectures=native
# Répertoires d'écriture strictement nécessaires (config, données, runtime)
ReadWritePaths=%h/.config/security-linux %h/.local/share/security-linux %h/.cache/security-linux %t

[Install]
WantedBy=graphical-session.target